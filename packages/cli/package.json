{
  "name": "@waterx/predict-agent-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The `waterx-predict` CLI: the canonical universal-agent surface over the command contract. Discovery, the market and account read plane, and the one-shot market-order write plane behind an enforced execution policy. No durable job outlives an invocation.",
  "license": "MIT",
  "type": "module",
  "bin": { "waterx-predict": "dist/src/main.js" },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/src/main.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@waterx/predict-agent-schema": "workspace:*",
    "@waterx/predict-agent-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
